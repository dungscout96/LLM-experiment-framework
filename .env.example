# API Keys for free LLM endpoints

# Groq API (free tier available)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace API (free tier available)
# Get your key at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here

# Optional: HuggingFace Hub token for downloading gated models
HUGGING_FACE_HUB_TOKEN=your_hf_hub_token_here
